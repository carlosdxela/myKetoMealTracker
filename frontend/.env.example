# Copy to .env and fill in from `cdk deploy` outputs (or the AWS console).
# These are baked into the frontend at build time — rebuild after changing them.
VITE_API_URL=https://<api-id>.execute-api.us-west-2.amazonaws.com
VITE_REGION=us-west-2
VITE_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
